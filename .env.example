# docker compose / Aiven App Runtime
OPA_LOG_LEVEL=info
PORT=8181
OPA_PUBLISH=8181

# --- Built-in DataHub sync (omit DATAHUB_GMS_URL to disable) ---
# GMS base URL only — no /api/graphql suffix. Container must reach this host (VPC / public).
# DATAHUB_GMS_URL=https://your-datahub-gms.example
# DATAHUB_TOKEN=
# SYNC_INTERVAL_SECONDS=120
